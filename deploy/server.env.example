# Copy to deploy/server.env. Never commit the filled file.
CLONE_AI_DOMAIN=agent.example.com
CLONE_AI_PUBLIC_URL=https://agent.example.com

# Generate with: openssl rand -hex 32
CLONE_AI_COMPANION_TOKEN=

# Generate another independent value with: openssl rand -hex 32
# Caddy injects this header; direct access to the app port is refused.
CLONE_AI_PROXY_SECRET=

# Generate with:
# docker run --rm caddy:2.8 caddy hash-password --plaintext 'change-me'
CLONE_AI_BASIC_AUTH_USER=owner
CLONE_AI_BASIC_AUTH_HASH=''

# Remote model/provider credentials used by the Main Agent.
# Keep these values here; they are passed to the container environment only.
CLONE_AI_MAIN_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional WhatsApp Cloud API defaults. The app's Phone channel wizard can
# also write these into the persistent /data volume.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_NUMBERS=

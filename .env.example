# Clone AI environment variables
# Copy this file to `.env` in your clone home or export them in the shell.
# Values here are names and examples only — never paste live API keys into git.

# Where journal, config, memory, and isolated workspaces live (default: ~/.clone)
# CLONE_HOME=
# CLONE_AI_DATA_DIR=

# Project the workers run against (default: current working directory)
# CLONE_AI_WORKSPACE=

# Main Agent model, as the OpenAI-compatible endpoint names it
# CLONE_AI_MAIN_MODEL=
# The endpoint both the Main Agent and the native worker call. Without it a
# turn fails with a message naming the missing variables.
# CLONE_AI_NATIVE_BASE_URL=http://127.0.0.1:3425
# CLONE_AI_NATIVE_MODEL=
# CLONE_AI_NATIVE_API_KEY=
# Rounds one native step may spend, and the cap on a single completion
# CLONE_AI_NATIVE_MAX_ROUNDS=12
# CLONE_AI_NATIVE_MAX_TOKENS=16000
# "refuse-existing" makes write_file reject an existing path (the repair lane
# sets this for itself; leave it unset for normal use)
# CLONE_AI_NATIVE_WRITE_FILE=

# Opt-in paid planner (omit to keep the local deterministic planner)
# CLONE_AI_PLANNER=openai
# OPENAI_API_KEY=
# CLONE_AI_PLANNER_MODEL=gpt-5

# Journal backend (sqlite is the default; jsonl is the inspectable file)
# CLONE_AI_JOURNAL=sqlite

# Companion listen port (default 4317)
# CLONE_AI_PORT=4317

# Memory mining runs after a completed task and costs one model call; the
# default is on whenever the endpoint above is configured

# Live tests only — do not set these for normal use
# CLONE_AI_MAIN_LIVE=1

# WhatsApp Cloud API phone bridge (optional)
# Keep these values in the shell or LaunchAgent environment, never in git.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ALLOWED_NUMBERS=+8613800000000,+8613900000000
# WHATSAPP_GRAPH_VERSION=v23.0
# CLONE_AI_WHATSAPP_PORT=4318

# Server deployment (optional)
# CLONE_AI_PUBLIC_URL=https://agent.example.com
# CLONE_AI_COMPANION_TOKEN=
# CLONE_AI_PROXY_SECRET=
# CLONE_AI_WHATSAPP_HOST=0.0.0.0

      "evidence": [
        { "stepId": "write-report", "kind": "artifact", "summary": "Wrote report.md.", "locator": "report.md" }
      ],
      "ownerVerdict": "pass",
      "note": "The positive control: existence, non-emptiness, and the required substring all hold."
    },

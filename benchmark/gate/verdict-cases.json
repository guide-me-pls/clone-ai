{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "file-with-required-content",
      "title": "A promised file exists with the required content",
      "plan": {
        "steps": [
          {
            "id": "write-report",
            "title": "Write the weekly report",
            "instructions": "Write report.md with this week's summary.",
            "risk": "reversible_write",
            "acceptanceCriteria": [
              "report.md contains \"本周完成\""
            ]
          }
        ]
      },
      "workspace": {
        "report.md": "本周完成：3 项\n"
      },
      "evidence": [
        {
          "stepId": "write-report",
          "kind": "artifact",
          "summary": "Wrote report.md.",
          "locator": "report.md"
        }
      ],
      "ownerVerdict": "pass",
      "note": "The positive control: existence, non-emptiness, and the required substring all hold."
    },

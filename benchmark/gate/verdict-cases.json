            "id": "write-report",
            "title": "Write the weekly report",
            "instructions": "Write report.md with this week's summary.",
            "risk": "reversible_write",
            "acceptanceCriteria": ["report.md contains \"本周完成\""]
          }
        ]
      },
      "workspace": {
        "report.md": "本周完成：3 项\n"

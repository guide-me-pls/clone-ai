      "expectedOutcome": "denied"
    },
    {
      "id": "shell-exec-act-auto-allowed",
      "title": "An act_auto shell policy allows a named command",
      "step": {
        "id": "run-git",
        "title": "Run git",
        "instructions": "Run git status.",
        "risk": "read_only",
        "acceptanceCriteria": [],
        "scopes": [{ "domain": "shell", "resource": "git", "access": "exec" }]

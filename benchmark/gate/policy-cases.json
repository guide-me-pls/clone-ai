    {
      "id": "unenforced-domain-denied",
      "title": "A domain without enforcement cannot be granted",
      "step": {
        "id": "read-calendar",
        "title": "Read the calendar",
        "instructions": "Read today's calendar.",
        "risk": "read_only",
        "acceptanceCriteria": [],
        "scopes": [{ "domain": "calendar", "resource": "primary", "access": "read" }]
      },
      "approved": false,
      "authority": {
        "version": 1,
        "domains": { "calendar": "act_auto" },
        "policies": [
          {
            "id": "calendar-read",
            "label": "A grant for a domain that is not enforced yet",
            "scopes": [{ "domain": "calendar", "resource": "primary", "access": "read" }],
            "maxAutonomy": "act_auto",
            "createdAt": "2026-01-01T00:00:00.000Z"
          }
        ]
      },
      "expectedOutcome": "denied",

          },
          {
            "id": "projects-secret-observe",
            "label": "Only observe the secret subtree",
            "scopes": [{ "domain": "files", "resource": "~/projects/secret", "access": "write" }],
            "maxAutonomy": "observe",
            "createdAt": "2026-01-01T00:00:00.000Z"
          }
        ]
      },
      "expectedOutcome": "denied",
      "note": "The lowest ceiling among covering policies wins, so an explicit restriction is never overridden by a broader grant."

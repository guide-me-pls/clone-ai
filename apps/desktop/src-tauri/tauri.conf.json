{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clone-ai",
  "version": "0.1.0",
  "identifier": "ai.clone.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "clone-ai",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "backgroundColor": "#f6f7fb",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/clone-ai-daemon"]
  }
}

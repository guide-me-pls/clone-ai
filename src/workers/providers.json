{
  "providers": [
    {
      "id": "claude-code",
      "label": "Claude Code",
      "command": "claude",
      "args": [
        "{{modelArgs}}",
        "-p",
        "{{prompt}}"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_OAUTH_TOKEN",
        "CLAUDE_CONFIG_DIR",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_DEFAULT_*",
        "ANTHROPIC_SMALL_*",
        "ANTHROPIC_MODEL",
        "ANTHROPIC_SONNET",
        "ANTHROPIC_OPUS",
        "ANTHROPIC_HAIKU"
      ],
      "sandbox": "seatbelt",
      "sandboxNetwork": true,
      "sandboxWritePaths": [
        "~/.claude",
        "~/.claude.json"
      ],
      "modelArgs": [
        "--model",
        "{{model}}"
      ]
    },
    {
      "id": "codex-cli",
      "label": "Codex CLI",
      "command": "codex",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "{{modelArgs}}",
        "{{sandboxArgs}}",
        "{{prompt}}"
      ],
      "env": [
        "OPENAI_API_KEY",
        "CODEX_HOME"
      ],
      "sandbox": "seatbelt",
      "sandboxNetwork": true,
      "sandboxWritePaths": [
        "~/.codex"
      ],
      "sandboxArgs": [
        "--sandbox",
        "danger-full-access"
      ],
      "modelArgs": [
        "-m",
        "{{model}}"
      ]
    },
    {
      "id": "pi",
      "label": "Pi",
      "command": "pi",
      "args": [
        "{{modelArgs}}",
        "-p",
        "{{prompt}}"
      ],
      "env": [
        "GEMINI_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "OPENROUTER_API_KEY",
        "PI_CODING_AGENT_DIR",
        "PI_PACKAGE_DIR"
      ],
      "sandbox": "seatbelt",
      "sandboxNetwork": true,
      "sandboxWritePaths": [
        "~/.pi"
      ],
      "modelArgs": [
        "--model",
        "{{model}}"
      ]
    },
    {
      "id": "opencode",
      "label": "opencode",
      "command": "opencode",
      "args": [
        "run",
        "{{modelArgs}}",
        "{{prompt}}"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "OPENCODE_CONFIG"
      ],
      "sandbox": "seatbelt",
      "sandboxNetwork": true,
      "sandboxWritePaths": [
        "~/.local/share/opencode",
        "~/.config/opencode",
        "~/.cache/opencode",
        "~/.opencode"
      ],
      "modelArgs": [
        "-m",
        "{{model}}"
      ]
    }
  ]
}
